# Domain
DOMAIN=myodoo.com
ADMIN_DOMAIN=admin.myodoo.com
ACME_EMAIL=admin@myodoo.com

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=saas_control

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change_me_64_char_random_hex_string_here_replace_this_now
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# S3 Backup (optional — leave blank to use local storage)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Odoo Image
ODOO_IMAGE=myodoo.com/odoo-custom:17
ODOO_ADMIN_EMAIL=admin@myodoo.com

# Traefik dynamic config directory (mounted into control panel)
TRAEFIK_DYNAMIC_DIR=/etc/traefik/dynamic/tenants

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# SMTP (البريد الإلكتروني)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=noreply@myodoo.com
SMTP_TLS=true
